{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "pytest coverage for line_list_compare.py",
			"command": "pytest --cov=line_list_compare --cov-report=term-missing _tests/test_line_list_compare.py",
			"group": "test",
			"problemMatcher": [
				"$pytest"
			]
		},
		{
			"label": "PTS inspect reference workbooks",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe ${workspaceFolder}/PTS_highlighter/pts_highlighter.py --inspect",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "PTS focused tests",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe ${workspaceFolder}/PTS_highlighter/test_pts_highlighter.py",
			"problemMatcher": []
		},
		{
			"label": "PTS process schedules",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe ${workspaceFolder}/PTS_highlighter/pts_highlighter.py --overwrite",
			"problemMatcher": []
		}
	]
}